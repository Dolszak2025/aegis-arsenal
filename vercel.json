{
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "main.py"
    }
  ],
  "build": {
    "env": {
      "PYTHON_VERSION": "3.12.0",
      "UV_PYTHON_PREFERENCE": "only-managed",
      "UV_PYTHON_DOWNLOADS": "true"
    }
  }
}
